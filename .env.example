# Variables de entorno. NUNCA credenciales reales en este archivo: solo nombres y ejemplos vacíos.
# Copiar a .env y completar. .env está en .gitignore.

# --- Dominio y proxy ---
DOMAIN=hotel.example.com
ACME_EMAIL=admin@example.com

# --- Base de datos ---
# Ruta persistente del archivo SQLite. En Docker debe ser /data/hotel.sqlite3 (volumen nombrado).
JDBC_URL=/data/hotel.sqlite3

# --- Seguridad ---
# Secreto para crear el PRIMER administrador en /api/admin/init. Un solo uso.
# Generar con: openssl rand -hex 32
ADMIN_INIT_TOKEN=

# --- Booking.com Connectivity APIs ---
# Acceso restringido: ser Connectivity Partner (developer.booking.com/connectivity/docs).
# Autenticación vigente: token-based. La credential-based (Basic) se apagó el 31/12/2025.
BOOKING_CLIENT_ID=
BOOKING_CLIENT_SECRET=
BOOKING_HOTEL_ID=
# sandbox | prod
BOOKING_ENV=sandbox
# Opcional: endpoint base para sandbox propio. Vacío = host oficial del proveedor.
BOOKING_API_BASE=

# --- Despegar ---
# Acceso restringido: acuerdo de channel manager + mTLS + certificaciones del proveedor.
# La API key viaja en la cabecera x-apikey.
DESPEGAR_API_KEY=
DESPEGAR_HOTEL_CODE=
# sandbox | prod
DESPEGAR_ENV=sandbox
DESPEGAR_API_BASE=

# --- Airbnb ---
# Acceso restringido: programa de socios aprobado, NDA, API Terms y revisión de seguridad.
# OAuth 2.0; scopes: calendar:read/write, reservations:read/write.
AIRBNB_CLIENT_ID=
AIRBNB_CLIENT_SECRET=
AIRBNB_LISTING_IDS=
# sandbox | prod
AIRBNB_ENV=sandbox
AIRBNB_API_BASE=

# --- Operación ---
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/backups