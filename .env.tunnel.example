# Variables para el modo túnel (Cloudflare Tunnel). NUNCA credenciales reales aquí: solo nombres y
# ejemplos dummy. Copiar a .env y completar; .env está en .gitignore.
#
# A diferencia de .env.example, aquí NO hay DOMAIN ni ACME_EMAIL: no hay Caddy ni certificado propio,
# Cloudflare los resuelve. El túnel de prueba (`--url`) ni siquiera necesita dominio.
#
#   cp .env.tunnel.example .env
#   docker compose -f compose.tunnel.yaml up -d --build

# --- Puerto local que publica el frontend ---
# Único puerto del stack. Es el que apunta cloudflared (http://host.docker.internal:5173).
WEB_PORT=5173

# --- Seguridad ---
# Obligatorio: compose.tunnel.yaml falla al validar sin él.
# Secreto de un solo uso para crear el PRIMER administrador en /api/admin/init.
# Generar con: openssl rand -hex 32
ADMIN_INIT_TOKEN=cambia-esto-por-el-hex-de-openssl-rand-hex-32

# Superusuarios sembrados: "email:clave,email:clave". Solo crea faltantes; la clave sembrada
# es de un solo uso y al primer login se exige cambiarla.
# HOTEL_SEED_ADMINS=admin1@ejemplo.com:clave-inicial-1,admin2@ejemplo.com:clave-inicial-2
HOTEL_SEED_ADMINS=

# --- Ambiente ---
# En produccion el arranque FALLA si se activa HOTEL_DEMO_ADMIN.
HOTEL_AMBIENTE=produccion
HOTEL_DEMO_ADMIN=false

# --- Envío de correo (opcional) ---
# Solo si quieres avisos al hotel. Ver docs/operations/correo.md para obtener los tokens.
CORREO_HABILITADO=false
CORREO_REMITENTE=aviso@example.com
CORREO_REMITENTE_NOMBRE=Hotel
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Canales OTA (opcional) ---
# Acceso restringido: hay que ser partner de cada una. Sin esto quedan en NO_CONFIGURADO, que es
# el estado correcto, no un fallo.
BOOKING_CLIENT_ID=
BOOKING_CLIENT_SECRET=
BOOKING_HOTEL_ID=
BOOKING_ENV=sandbox
DESPEGAR_API_KEY=
DESPEGAR_HOTEL_CODE=
DESPEGAR_ENV=sandbox
AIRBNB_CLIENT_ID=
AIRBNB_CLIENT_SECRET=
AIRBNB_LISTING_IDS=
AIRBNB_ENV=sandbox

# --- Operación ---
BACKUP_RETENTION_DAYS=30
# Cada cuántos segundos respalda el servicio `respaldo` (86400 = diario).
# BACKUP_INTERVAL_SECONDS=86400
