# Caddy en producción (modo directo, con IP pública y Let's Encrypt).
# Solo para este modo: en modo túnel no hay proxy, quien termina TLS es Cloudflare.
#
# Un único `reverse_proxy` basta: el nginx de la imagen web ya reenvía `/api/*` a `api:8080`,
# así que no hace falta una segunda ruta aquí.
{$DOMAIN} {
	encode gzip
	reverse_proxy web:80

	# Las tres primeras ya las pone el nginx de la imagen web; aquí solo lo que no pone nadie más.
	header {
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
