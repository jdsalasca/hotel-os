# Contexto raíz. Aplica a los compose que construyen desde el repo entero; los dos servicios de
# producción (apps/api y apps/web) usan contextos propios y se rigen por sus .dockerignore.
.git/
node_modules/
target/
dist/
.env
.env.*
*.log
docs/screenshots/
.idea/
.vscode/

# Bases locales y respaldos: no se envían al daemon al construir desde el contexto raíz.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
data/
**/data/
backups/
**/backups/
